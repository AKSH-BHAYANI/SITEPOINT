# SITEPOINT Production Environment Variables Template
# Copy this file to .env and provide your production secrets.

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Database Configuration (Cloud SQL PostgreSQL)
SQL_HOST=
SQL_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
DATABASE_URL=

# JWT_SECRET: Strong secret key (min 32 characters) for signing and verifying authentication tokens.
JWT_SECRET=

# SITEPOINT_BOOTSTRAP_SECRET: Server-only secret key required for one-time initial Boss account setup.
# Never expose to client-side code. If missing, initial Boss account creation is refused.
SITEPOINT_BOOTSTRAP_SECRET=

# CORS and Security configuration
ALLOWED_ORIGINS=

# Optional SMTP Mailer configuration for password resets
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
